<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fineract" id="9008-1">
        <!-- Add linking field to connect loan guarantors with KYC guarantors -->
        <addColumn tableName="m_guarantor">
            <column name="extend_guarantor_kyc_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="9008-2">
        <!-- Add foreign key constraint to guarantor KYC details table -->
        <addForeignKeyConstraint baseTableName="m_guarantor"
                                 baseColumnNames="extend_guarantor_kyc_id"
                                 constraintName="FK_guarantor_extend_kyc"
                                 referencedTableName="m_extend_guarantor_kyc_details"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet author="fineract" id="9008-3">
        <!-- Add index for performance on the linking field -->
        <createIndex tableName="m_guarantor" indexName="idx_guarantor_extend_kyc_id">
            <column name="extend_guarantor_kyc_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="9008-4">
        <!-- Add permissions for searching guarantor KYC details -->
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="SEARCH_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="SEARCH"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
