<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fineract" id="9006-1">
        <!-- Add OTP verification fields to existing client KYC table -->
        <addColumn tableName="m_extend_client_kyc_details">
            <!-- OTP Verification Fields -->
            <column name="aadhaar_otp_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="otp_client_id" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="otp_last_requested_on" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="otp_verified_on" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="9006-2">
        <!-- Update verification method enum to support OTP -->
        <modifyDataType tableName="m_extend_client_kyc_details" columnName="verification_method" newDataType="VARCHAR(20)"/>
    </changeSet>

    <changeSet author="fineract" id="9006-3">
        <!-- Add new permissions for OTP verification -->
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="VERIFY_OTP_CLIENT_KYC"/>
            <column name="entity_name" value="CLIENT_KYC"/>
            <column name="action_name" value="VERIFY_OTP"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="GENERATE_OTP_CLIENT_KYC"/>
            <column name="entity_name" value="CLIENT_KYC"/>
            <column name="action_name" value="GENERATE_OTP"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="9006-4">
        <!-- Add index for OTP client ID -->
        <createIndex tableName="m_extend_client_kyc_details" indexName="idx_extend_kyc_otp_client_id">
            <column name="otp_client_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
