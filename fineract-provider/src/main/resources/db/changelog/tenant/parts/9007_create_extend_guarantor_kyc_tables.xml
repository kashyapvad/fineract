<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fineract" id="9007-1">
        <createTable tableName="m_extend_guarantor_kyc_details">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Guarantor Core Identity (Master Record) -->
            <column name="full_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="mobile_number" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="relationship_to_client" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <!-- Guarantor KYC Document Fields -->
            <column name="pan_number" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="aadhaar_number" type="VARCHAR(12)">
                <constraints nullable="false"/>
            </column>

            <!-- Verification Status Fields -->
            <column name="pan_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="aadhaar_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <!-- OTP Verification Fields -->
            <column name="aadhaar_otp_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="otp_client_id" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="otp_last_requested_on" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="otp_verified_on" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>

            <!-- Manual Verification Fields -->
            <column name="pan_manually_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="aadhaar_manually_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="manual_verification_reason" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <!-- Verification Metadata -->
            <column name="verification_method" type="VARCHAR(20)" defaultValue="MANUAL">
                <constraints nullable="false"/>
            </column>
            <column name="last_verified_on" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="verification_provider" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="verified_by_user_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>

            <!-- Provider-Agnostic Response Storage -->
            <column name="api_response_data" type="JSONB">
                <constraints nullable="true"/>
            </column>
            <column name="verification_notes" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <!-- Status Fields -->
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_primary_guarantor" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <!-- Audit Fields -->
            <column name="created_on_utc" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="fineract" id="9007-2">
        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint baseTableName="m_extend_guarantor_kyc_details"
                                 baseColumnNames="client_id"
                                 constraintName="FK_extend_guarantor_kyc_client"
                                 referencedTableName="m_client"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="m_extend_guarantor_kyc_details"
                                 baseColumnNames="verified_by_user_id"
                                 constraintName="FK_extend_guarantor_kyc_user"
                                 referencedTableName="m_appuser"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="m_extend_guarantor_kyc_details"
                                 baseColumnNames="created_by"
                                 constraintName="FK_extend_guarantor_kyc_created_user"
                                 referencedTableName="m_appuser"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="m_extend_guarantor_kyc_details"
                                 baseColumnNames="last_modified_by"
                                 constraintName="FK_extend_guarantor_kyc_modified_user"
                                 referencedTableName="m_appuser"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet author="fineract" id="9007-3">
        <!-- Add indexes for performance -->
        <createIndex tableName="m_extend_guarantor_kyc_details" indexName="idx_extend_guarantor_kyc_client_id">
            <column name="client_id"/>
        </createIndex>

        <createIndex tableName="m_extend_guarantor_kyc_details" indexName="idx_extend_guarantor_kyc_aadhaar">
            <column name="aadhaar_number"/>
        </createIndex>

        <createIndex tableName="m_extend_guarantor_kyc_details" indexName="idx_extend_guarantor_kyc_mobile">
            <column name="mobile_number"/>
        </createIndex>

        <createIndex tableName="m_extend_guarantor_kyc_details" indexName="idx_extend_guarantor_kyc_verification_method">
            <column name="verification_method"/>
        </createIndex>

        <createIndex tableName="m_extend_guarantor_kyc_details" indexName="idx_extend_guarantor_kyc_last_verified">
            <column name="last_verified_on"/>
        </createIndex>

        <!-- PostgreSQL-specific GIN index for JSONB -->
        <sql>CREATE INDEX idx_extend_guarantor_kyc_api_response_gin ON m_extend_guarantor_kyc_details USING GIN (api_response_data);</sql>
    </changeSet>

    <!-- Add GUARANTOR_KYC permissions -->
    <changeSet author="fineract" id="9007-4">
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="READ_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="CREATE_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="UPDATE_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="DELETE_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="DELETE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="VERIFY_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="VERIFY"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="VERIFY_OTP_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="VERIFY_OTP"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="VERIFY_API_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="VERIFY_API"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="VERIFY_MANUAL_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="VERIFY_MANUAL"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="Custom"/>
            <column name="code" value="UNVERIFY_MANUAL_GUARANTOR_KYC"/>
            <column name="entity_name" value="GUARANTOR_KYC"/>
            <column name="action_name" value="UNVERIFY_MANUAL"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
